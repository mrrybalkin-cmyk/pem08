# development enables reload on non-Windows hosts; Windows and production run without reload for Playwright compatibility. Bind locally by default.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# Structured text/vision analysis through an OpenAI-compatible provider.
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-6-luna
AI_REASONING_EFFORT=low
# Leave AI_REASONING_EFFORT empty to omit it for models/providers without support.
# Provider timeout in seconds.
AI_TIMEOUT_SECONDS=60

DATABASE_URL=sqlite:///./data/app.db
UPLOAD_DIR=./data/uploads
SCREENSHOT_DIR=./data/screenshots
MAX_IMAGE_MB=10
MAX_PDF_MB=25
MAX_TEXT_CHARS=30000
MAX_WEB_TEXT_CHARS=25000
MAX_PDF_PAGES_ANALYZED=8
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_MS=20000
BROWSER_VIEWPORT_WIDTH=1440
BROWSER_VIEWPORT_HEIGHT=1200
# Explicit origins, comma-separated; empty disables cross-origin access. No credentials.
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
LOG_LEVEL=INFO
